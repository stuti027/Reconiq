# normalization-service configuration. Copy to .env and fill in for local runs; all values have
# working defaults for the private sandbox (phase2-sandbox/docker-compose.yml) except passwords.

APP_MODE=all

KAFKA_HOST=localhost
KAFKA_PORT=9092

SCHEMA_REGISTRY_URL=http://localhost:8081

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=reconciliation
POSTGRES_USER=reconiq
POSTGRES_PASSWORD=reconiq_local_dev

INPUT_TOPICS=raw-transactions
CANONICAL_TOPIC=txn.canonical
DLQ_TOPIC=txn.canonical.dlq

TOPICS_AUTO_CREATE=true
TOPIC_PARTITIONS=3
TOPIC_REPLICATION=1

STREAMS_APPLICATION_ID=normalization-service
STREAMS_THREADS=1

WRITER_GROUP_ID=normalization-writer
WRITER_BATCH_SIZE=500
WRITER_CONFLICT_POLICY=REPORT

HEALTH_PORT=8090

DLQ_GUARD_ACTION=alarm
DLQ_GUARD_WINDOW_SECONDS=60
DLQ_GUARD_PROCESSING_ERRORS=5
DLQ_GUARD_REJECT_RATIO=0.5
DLQ_GUARD_MIN_RECORDS=100

LOG_LEVEL=INFO
LOG_SUMMARY_SECONDS=30
