# PostgreSQL (Phase 2's canonical data + Phase 4's own tables)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=reconciliation
POSTGRES_USER=
POSTGRES_PASSWORD=

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Phase 5: where finished investigation results are POSTed (a stub receiver until Phase 5 exists)
PHASE5_RESULT_URL=

# Background worker (optional; the values below are the defaults)
WORKER_ENABLED=true
MAX_CONCURRENT_INVESTIGATIONS=2
MAX_PICKUPS=3
WORKER_POLL_SECONDS=2
BACKOFF_BASE_SECONDS=1
BACKOFF_CAP_SECONDS=60

# /health turns DEGRADED at or above these (optional; defaults shown)
HEALTH_BACKLOG_MAX=50
HEALTH_BACKLOG_MAX_AGE_SECONDS=600
HEALTH_FAILED_SPIKE=10
HEALTH_FAILED_WINDOW_SECONDS=600

LOG_LEVEL=INFO
